// Check whether the two older tag writes targeted the lab resource group during setup.
// Review ResourceId, ResourceGroup, and CorrelationId together; this query tests a hypothesis.
let startTime = datetime(2026-10-11 01:30:00Z);
let endTime = datetime(2026-10-11 07:46:00Z);
AzureActivity
| where TimeGenerated between (startTime .. endTime)
| where OperationNameValue =~ "MICROSOFT.RESOURCES/TAGS/WRITE"
| where ActivityStatusValue =~ "Success"
| project TimeGenerated, OperationNameValue, ResourceGroup, ResourceId,
          CorrelationId, OperationId, EventDataId, ActivityStatusValue
| sort by TimeGenerated asc
